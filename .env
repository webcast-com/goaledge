# ── Affiliate links (odds comparison) ────────────────────────────────────────
# Optional template for tracked affiliate links. Placeholders:
# {bookmaker} {odds} {home} {away} {prediction}
# AFFILIATE_URL_TEMPLATE=https://track.your-affiliate.com/?a=123&m={bookmaker}&o={odds}

# ── Auth ────────────────────────────────────────────────────────────────────
# Signs the session cookie (HS256). Rotate with: openssl rand -base64 32
# Rotating invalidates every existing session — users just sign in again.
