# Local SQLite file — must match the `sqlite` datasource in prisma/schema.prisma.
# (The old Prisma Postgres URL cannot work with the sqlite schema + libSQL adapter;
# src/lib/db.ts now falls back to this file if a non-file: URL ever sneaks in.)
DATABASE_URL="file:./db/custom.db"


# ── Payments (Paystack) ─────────────────────────────────────────────────────
# Leave empty to run in demo mode (simulated checkout). Set both to go live:
# PAYSTACK_SECRET_KEY=sk_test_xxx
# NEXT_PUBLIC_PAYSTACK_KEY=pk_test_xxx

# ── Live football data (football-data.org) ───────────────────────────────────
# Optional — the key can also be saved from the Admin → API Key panel.
# FOOTBALL_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Affiliate links (odds comparison) ────────────────────────────────────────
# Optional template for tracked affiliate links. Placeholders:
# {bookmaker} {odds} {home} {away} {prediction}
# AFFILIATE_URL_TEMPLATE=https://track.your-affiliate.com/?a=123&m={bookmaker}&o={odds}

# ── Auth ────────────────────────────────────────────────────────────────────
# Signs the session cookie (HS256). Rotate with: openssl rand -base64 32
# Rotating invalidates every existing session — users just sign in again.
AUTH_SECRET="eot6rudPPIDJB3kgrlNJVzJHLOmjslP1LM7qe4sU1Rc="
