# Supabase project (server-side database access)
# Find the URL and a server-only Secret key / service_role key in Project Settings → API.
# Never prefix the secret key with NEXT_PUBLIC_ or expose it to browser code.
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_SECRET_KEY="YOUR-SUPABASE-SECRET-KEY"
# Older Supabase projects may use SUPABASE_SERVICE_ROLE_KEY instead.
# SUPABASE_SERVICE_ROLE_KEY="YOUR-SERVICE-ROLE-KEY"

# ── Payments (Paystack) ─────────────────────────────────────────────────────
# Leave BOTH empty for demo mode. Set BOTH with matching test/live keys to go live:
# PAYSTACK_SECRET_KEY=sk_test_xxx        # server only; keep private
# NEXT_PUBLIC_PAYSTACK_KEY=pk_test_xxx   # included in the browser bundle
# Never commit an sk_live_... key. Put live credentials in your host's secrets
# store or in the local, git-ignored .env; GitHub push protection rejects live keys.

# ── Live football data (football-data.org) ───────────────────────────────────
# Optional — the key can also be saved from the Admin → API Key panel.
# NOTE: a key saved in the app (DB AppSetting "football_api_key") takes precedence
#       over this variable. Ask GET /api/diagnostics/football which one is in use.
FOOTBALL_API_KEY=your-football-data-org-key
# Pause between API calls. Default 6100ms ≈ the free tier's 10 requests/minute;
# lower it if your plan allows more (e.g. 3000 for 20 req/min).
# FOOTBALL_API_MIN_INTERVAL_MS=6100

# ── Affiliate links (odds comparison) ────────────────────────────────────────
# Optional template for tracked affiliate links. Placeholders:
# {bookmaker} {odds} {home} {away} {prediction}
# AFFILIATE_URL_TEMPLATE=https://track.your-affiliate.com/?a=123&m={bookmaker}&o={odds}

# ── Auth ────────────────────────────────────────────────────────────────────
# Signs the session cookie (HS256). Strongly recommended in production —
# generate one with: openssl rand -base64 32
# If unset, a public development secret is used (and a warning is logged).
# The legacy NEXTAUTH_SECRET is still read as a fallback, so sessions issued
# before the NextAuth removal stay valid.
# AUTH_SECRET= # generate with: openssl rand -base64 32
